PORT=8001

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/Gyaani-AI-auth

REDIS_URL=redis://localhost:6379

# Also required: place your Firebase Admin SDK service account key at
# ./serviceAccountKey.json (Firebase Console > Project Settings > Service Accounts
# > Generate new private key). Never commit this file.
